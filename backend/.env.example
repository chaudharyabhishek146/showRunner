# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Demo target ----------------------------------------------------------
# The throwaway GitHub account/repo the walkthrough drives.
TARGET_URL=https://github.com
DEMO_REPO=your-demo-org/walkthrough-sandbox

# Auth is supplied out-of-band: paste the `user_session` cookie from an already
# signed-in browser. The agent never types credentials into a login form.
GITHUB_SESSION_COOKIE=

# --- Browser --------------------------------------------------------------
HEADLESS=true
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900
SLOW_MO_MS=250
STEP_DWELL_SECONDS=1.5

# --- Features -------------------------------------------------------------
VOICE_ENABLED=true
