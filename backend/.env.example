# Copy to backend/.env and fill in. Never commit the filled-in file.

# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Locked demo ----------------------------------------------------------
# On by default. The UI offers no document, no flow and no tab — it runs the
# preset below and nothing else, so a hackathon run is identical every time and
# there is nothing to fat-finger on stage. Set false to hand the choice back to
# the presenter; the engine underneath is the same either way.
DEMO_LOCKED=true
LOCKED_DEMO_SAMPLE=youtube-2-minute
LOCKED_DEMO_TAB=youtube
# LOCKED_DEMO_TITLE=YouTube — the two-minute version
# LOCKED_DEMO_FOCUS=

# Before planning, offer to wait while you sign in. Signed-out and signed-in
# YouTube are different products and the plan has to know which it is looking
# at. The agent never types a credential — it waits, then checks the page.
ASK_TO_SIGN_IN=true
SIGN_IN_PROMPT_TIMEOUT=180

# --- Demo target ----------------------------------------------------------
# There isn't one. The site, the flow, and the document are all supplied per
# run from the UI: upload a product doc, say what to demo, pick an open tab.
# The navigation allowlist is derived from whichever tab you pick.
#
# Add hosts here only if a demo legitimately crosses domains (a docs site, an
# auth provider, a CDN-hosted app shell). Comma-separated, no scheme.
EXTRA_ALLOWED_HOSTS=

# Where uploaded product documents are cached. Defaults to backend/data/uploads.
# UPLOAD_DIR=

# Example documents offered as one-click starting points in the UI. Any .md
# dropped in here shows up as its own button, titled from the file's H1.
# SAMPLES_DIR=

# --- Browser --------------------------------------------------------------
# The agent attaches to the Chrome you are already signed into, over the
# DevTools protocol — that is why there are no credentials in this file. Start
# Chrome with:
#
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-port=9222 \
#     --user-data-dir="$HOME/chrome-demo-profile" \
#     --enable-automation
#
# All three flags matter: Chrome 136+ refuses the debug port on the default
# profile, and Chrome 151+ rejects the CDP handshake without --enable-automation.
CHROME_CDP_URL=http://localhost:9222

# On by default: if the debug port isn't open when a walkthrough starts, the
# agent runs that command itself rather than making you paste it mid-meeting.
# Only ever applies when CHROME_CDP_URL points at this machine and Chrome is
# actually installed on it — a deployed backend silently skips it.
AUTO_LAUNCH_CHROME=true
# The profile that Chrome is launched with. It persists, so you sign into the
# products you demo once and it stays signed in.
# CHROME_PROFILE_DIR=$HOME/chrome-demo-profile
# Set only if Chrome lives somewhere non-standard.
# CHROME_BINARY=

# false skips the attach and launches a fresh, signed-out browser instead —
# useful for tests and for demoing a public site.
ATTACH_TO_CHROME=true

# Only used when ATTACH_TO_CHROME=false. "chrome" drives real Google Chrome,
# "msedge" for Edge, empty for Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome

# Also only for the fallback launch — an attached Chrome is whatever it already
# is. true keeps the fallback offscreen and you share the app's own UI.
HEADLESS=false
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# Meeting pacing. Slower than you think you want: the audience is reading the
# narration while the browser moves, and they need time to do both.
SLOW_MO_MS=250
STEP_DWELL_SECONDS=3

# --- Taking questions -----------------------------------------------------
# After each step the agent asks the room for questions and holds. The window
# restarts whenever someone actually asks, so follow-ups are never cut off, and
# the Skip / "Carry on" control ends it early when the room is quiet.
# Set to 0 to run the whole demo without stopping.
QUESTION_BREAK_SECONDS=12

# The longer hold at the end, where the questions actually arrive. A question
# asked here can still extend the demo — the agent re-plans and shows it.
CLOSING_QUESTION_SECONDS=60

# Live frame stream into the UI panel. 4 fps at quality 62 is ~40KB/frame,
# which reads as continuous without saturating a conference-room connection.
# Drop to 2 fps on hotel wifi.
LIVE_FPS=4
FRAME_QUALITY=62

# --- On-page overlay ------------------------------------------------------
# The OS mouse pointer is NOT captured in screenshots, so the agent draws its
# own cursor into the page: it glides to each target, spotlights it, and pulses
# on click. Turn this off and the audience sees buttons activate by themselves.
SHOW_CURSOR=true
CURSOR_TRAVEL_SECONDS=0.6

# Narration burned into the page as a subtitle bar, so the browser view is
# self-explanatory even when shared without the app's chat panel.
SHOW_CAPTIONS=true

# Per-keystroke delay so typing is visible rather than instant.
TYPING_DELAY_MS=45

# --- Features -------------------------------------------------------------
VOICE_ENABLED=true
